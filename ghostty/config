# Font — try candidates: uncomment ONE family, then reload Ghostty (⌘⇧,)
font-family = CaskaydiaCove Nerd Font Mono
# font-family = Maple Mono NF                  (too thin)
# font-family = JetBrainsMono Nerd Font Mono   (too common)
# active = MonaspiceXe NF (Monaspace Xenon — slab serif)
# font-family = MonaspiceXe NF
# font-family = MonaspiceAr NF                 (Monaspace Argon — humanist/warm)
# font-family = MonaspiceNe NF                 (Monaspace Neon — neo-grotesque)
# font-family = CommitMono Nerd Font
# font-family = Hack Nerd Font Mono            (no ligatures, chunky)
# --- distinctive picks ---
# font-family = RecMonoCasual Nerd Font Mono   (Recursive Casual — playful)
# font-family = 0xProto Nerd Font Mono         (coding-designed, uncommon)
# font-family = BlexMono Nerd Font Mono        (IBM Plex Mono — humanist)
# font-family = VictorMono Nerd Font Mono      (cursive italics; use Medium)
font-size = 13
# ligatures (== -> => != >= etc.); italic face is auto-selected
font-feature = +calt

# Theme - Nord base with pure black background
background = 000000
foreground = d8dee9
selection-foreground = d8dee9
selection-background = 3b4252

# Palette (Nord)
palette = 0=#000000
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#5e81ac
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
palette = 8=#555555
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#e5e9f0

# Window
window-decoration = none
window-padding-x = 18
window-padding-y = 18
# Frosted terminal — the system desktop wallpaper shows through. Lower the
# opacity to reveal more wallpaper; raise toward 1.0 for a more solid terminal.
background-opacity = 0.85
background-blur = 40
alpha-blending = linear-corrected

# Rendering / quality-of-life
window-save-state = always
resize-overlay = never
window-colorspace = display-p3

# Appearance
adjust-cell-height = 8%
bold-color = bright
window-padding-balance = true
macos-icon = glass

# GLSL shaders live in ghostty/shaders/. Switch with `shader <name>`,
# list them with `shader`, turn them off with `shader off`.
# The active custom-shader line is managed at the bottom of this file.

# Cursor
cursor-style = block
cursor-style-blink = true
cursor-color = f5e0dc

# Behavior
mouse-hide-while-typing = true
macos-option-as-alt = true
scrollback-limit = 50000
confirm-close-surface = false

# Keybindings - tmux prefix Ctrl-b (\x02)
# Use physical key names (digit_N) to override Ghostty 1.2+ default goto_tab bindings
keybind = super+digit_1=text:\x02\x31
keybind = super+digit_2=text:\x02\x32
keybind = super+digit_3=text:\x02\x33
keybind = super+digit_4=text:\x02\x34
keybind = super+digit_5=text:\x02\x35
keybind = super+digit_6=text:\x02\x36
keybind = super+digit_7=text:\x02\x37
keybind = super+digit_8=text:\x02\x38
keybind = super+digit_9=text:\x02\x39
keybind = super+t=text:\x02c
keybind = super+shift+t=text:\x02!
keybind = super+w=text:\x02x
keybind = super+n=text:\x02-
keybind = super+shift+n=text:\x02|
keybind = super+z=text:\x02z
keybind = super+d=text:\x02d
keybind = super+k=text:\x02s
keybind = super+l=text:\x02L
keybind = super+r=text:\x02,
keybind = super+left_bracket=text:\x02[
keybind = super+shift+left_bracket=text:\x02p
keybind = super+shift+right_bracket=text:\x02n
keybind = super+f=text:\x02/
keybind = super+s=text:\x1b:w
keybind = global:super+backquote=toggle_quick_terminal
keybind = super+enter=toggle_fullscreen
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+digit_0=reset_font_size

# ── Command palette (⌘⇧P) ───────────────────────────────────────────────────
# Ghostty's palette can't be restyled, but it can be extended. These put this
# setup's own commands one fuzzy-search away — no keybinds to memorise.
# `text:` types the command and \n runs it, so they only work in a shell prompt.
command-palette-entry = title:"Theme: Pick…",description:"fzf picker with live preview",action:"text:theme\n"
command-palette-entry = title:"Theme: Mocha",description:"Catppuccin Mocha everywhere",action:"text:theme mocha\n"
command-palette-entry = title:"Theme: Macchiato",description:"Catppuccin Macchiato everywhere",action:"text:theme macchiato\n"
command-palette-entry = title:"Theme: Frappe",description:"Catppuccin Frappe everywhere",action:"text:theme frappe\n"
command-palette-entry = title:"Theme: Latte (light)",description:"Catppuccin Latte everywhere",action:"text:theme latte\n"
command-palette-entry = title:"Bar: Toggle Layout",description:"Switch sketchybar between slab and islands",action:"text:barstyle\n"
command-palette-entry = title:"Bar: Toggle Blur",description:"Frosted glass vs clear transparency",action:"text:barblur\n"
command-palette-entry = title:"Bar: Opacity…",description:"Set the sketchybar tint opacity 0-100",action:"text:baropacity "
command-palette-entry = title:"Tmux: Session Picker",description:"Switch or create a session with sesh",action:"text:sesh connect $(sesh list | fzf)\n"
command-palette-entry = title:"Files: Yazi",description:"Open the yazi file manager",action:"text:yazi\n"
command-palette-entry = title:"Git: Lazygit",description:"Open lazygit in the current repo",action:"text:lazygit\n"
command-palette-entry = title:"System: btop",description:"Resource monitor",action:"text:btop\n"
command-palette-entry = title:"Shader: List…",description:"Show shaders and the active one",action:"text:shader\n"
command-palette-entry = title:"Shader: Off",description:"Disable terminal shaders",action:"text:shader off\n"
command-palette-entry = title:"Shader: Cursor Tail",description:"Subtle cursor trail",action:"text:shader cursor_tail\n"
command-palette-entry = title:"Shader: Cursor Blaze",description:"Flame-like cursor trail",action:"text:shader cursor_blaze\n"
command-palette-entry = title:"Shader: Ripple",description:"Ripple pulse from the cursor",action:"text:shader ripple_cursor\n"
command-palette-entry = title:"Shader: Bloom",description:"Soft ambient glow",action:"text:shader bloom\n"
command-palette-entry = title:"Dotfiles",description:"cd to the dotfiles repo",action:"text:cd ~/Dev/dotfiles\n"

# Theme override (managed by gtheme script)
config-file = ~/.config/ghostty/current-theme

# All-dark override — loaded AFTER the theme so pure-black wins
config-file = ~/Dev/dotfiles/ghostty/all-dark

# custom-shader = /Users/saurabh/Dev/dotfiles/ghostty/shaders/cursor_blaze.glsl
custom-shader-animation = true
