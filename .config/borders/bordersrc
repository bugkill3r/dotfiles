#!/usr/bin/env bash
# JankyBorders — theme-aware window borders.
# Deliberately colorless: the focused window gets a light grey outline, the
# unfocused ones a dark grey one. Focus is shown by contrast alone, so the
# border never competes with the bar's accent.
# Greys follow the active catppuccin flavor (~/.config/catppuccin-flavor);
# `theme` restarts this service, so switching flavors updates them too.

case "$(cat "$HOME/.config/catppuccin-flavor" 2>/dev/null || echo mocha)" in
  latte)     on=7c7f93; off=bcc0cc ;;   # light theme: darker line reads as "on"
  frappe)    on=b5bfe2; off=51576d ;;
  macchiato) on=b8c0e0; off=494d64 ;;
  mocha|*)   on=a6adc8; off=45475a ;;
esac

borders \
  style=round \
  width=4.0 \
  hidpi=on \
  active_color=0xff${on} \
  inactive_color=0x40${off}
