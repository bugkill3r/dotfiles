#!/usr/bin/env bash
# JankyBorders — theme-aware window borders.
# Reads the active Ghostty palette so the border matches the current theme.
theme="$HOME/.config/ghostty/current-theme"
hex() { grep -E "^[[:space:]]*palette[[:space:]]*=[[:space:]]*$1[[:space:]]*=" "$theme" 2>/dev/null \
        | grep -oE '[0-9a-fA-F]{6}' | tail -1; }
accent=$(hex 5); alt=$(hex 4)          # magenta + blue from the theme
accent=${accent:-c6a0f6}; alt=${alt:-8aadf4}   # fallback: catppuccin macchiato

borders \
  style=round \
  width=6.0 \
  hidpi=on \
  active_color="gradient(top_left=0xff${accent},bottom_right=0xff${alt})" \
  inactive_color=0x00000000
