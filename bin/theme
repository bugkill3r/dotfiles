#!/usr/bin/env bash
# Unified Catppuccin theme switcher.
#   theme                 → fzf picker with live preview (like gtheme)
#   theme <flavor>        → apply directly (mocha|macchiato|frappe|latte)
# Themes Ghostty, btop, yazi, bat, nvim, borders. tmux/statusline/gradient/fzf
# auto-follow the palette. Does NOT modify `gtheme` — it *calls* it for Ghostty.
set -uo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
GT="/Applications/Ghostty.app/Contents/Resources/ghostty/themes"
FLAVORS=(macchiato mocha frappe latte)

cap() { printf '%s%s' "$(tr '[:lower:]' '[:upper:]' <<< "${1:0:1}")" "${1:1}"; }

# FAST live preview — only the instant OSC color change. Ghostty repaints and
# the tmux bar (ANSI colours) follows automatically. Kept lightweight so arrow
# navigation in the picker stays snappy.
apply_live() {
  local flavor="$1" c g
  c="$(cap "$flavor")"; g="Catppuccin ${c}"
  [[ -f "$GT/$g" ]] || return 0
  cat "$GT/$g" > "$HOME/.config/ghostty/current-theme"
  printf '%s\n' "$g" > "$HOME/.config/ghostty/.last-theme"
  gtheme --apply "$g" 2>/dev/null || true
}

# Everything: live bits + gradient/borders refresh + per-app configs.
apply_full() {
  local flavor="$1" c; c="$(cap "$flavor")"
  apply_live "$flavor"
  # apply_live's OSC only reaches a real terminal. Reload Ghostty's config too,
  # so a full apply works even when `theme` is run from a script/non-tty.
  osascript -e 'tell application "System Events" to tell process "Ghostty" to click menu item "Reload Configuration" of menu 1 of menu bar item "Ghostty" of menu bar 1' >/dev/null 2>&1 || true
  tmux refresh-client -S 2>/dev/null || true
  command -v borders >/dev/null 2>&1 &&
    launchctl kickstart -k "gui/$(id -u)/com.felixkratz.borders" 2>/dev/null || true
  local btop="$HOME/.config/btop/btop.conf"
  [[ -f "$btop" ]] && sed -i '' -E \
    "s|^color_theme = .*|color_theme = \"$HOME/.config/btop/themes/catppuccin_${flavor}.theme\"|" "$btop"
  local yt="$HOME/.config/yazi/theme.toml"
  [[ -f "$yt" ]] && grep -q 'dark = ' "$yt" && sed -i '' -E \
    "s|dark = \".*\"|dark = \"catppuccin-${flavor}\"|" "$yt"
  cat > "$HOME/.config/active-theme.sh" <<EOF
# generated by \`theme\` — sourced from .zshrc
export BAT_THEME="Catppuccin ${c}"
export CATPPUCCIN_FLAVOR="${flavor}"
EOF
  printf '%s\n' "$flavor" > "$HOME/.config/catppuccin-flavor"
  # recolor the menu bar — sketchybar's colors.sh reads catppuccin-flavor at
  # startup, so kick the service to re-read it (no tap-trust needed).
  command -v sketchybar >/dev/null 2>&1 &&
    launchctl kickstart -k "gui/$(id -u)/homebrew.mxcl.sketchybar" 2>/dev/null || true
}

# Internal: called by the picker's focus binding for live preview
if [[ "${1:-}" == "--apply-live" ]]; then apply_live "$2"; exit 0; fi

flavor="${1:-}"

# No arg → interactive picker with live preview (Esc reverts)
if [[ -z "$flavor" ]]; then
  current="$(cat "$HOME/.config/catppuccin-flavor" 2>/dev/null || echo macchiato)"
  list="$(printf '%s\n' "$current"; printf '%s\n' "${FLAVORS[@]}" | grep -vxF "$current")"
  flavor="$(printf '%s\n' "$list" | FZF_DEFAULT_OPTS="" fzf \
    --no-sort --layout=reverse --height=40% \
    --prompt="  theme > " --header="catppuccin flavor · live preview · esc to cancel" \
    --bind "focus:execute-silent(\"$SELF\" --apply-live {})")" || flavor=""
  if [[ -z "$flavor" ]]; then
    apply_live "$current"; echo "Reverted to $current"; exit 0
  fi
fi

case "$flavor" in
  mocha|macchiato|frappe|latte) ;;
  *) echo "usage: theme [mocha|macchiato|frappe|latte]   (no arg = picker)"; exit 1 ;;
esac

apply_full "$flavor"
echo "🎨 Catppuccin $(cap "$flavor") → ghostty · tmux · statusline · fzf · btop · yazi · bat · nvim · borders · sketchybar"
echo "   (btop/yazi/nvim update on next launch; run 'exec zsh' for bat/env)"
