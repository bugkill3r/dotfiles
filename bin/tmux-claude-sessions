#!/usr/bin/env python3
"""Save/restore the Claude Code conversation running in each tmux pane.

tmux-resurrect brings back the layout and working directories, but panes come
back as empty shells — `claude` isn't one of the programs it restarts, and even
if it were, a fresh `claude` starts a NEW conversation. This maps each pane to
the specific conversation it was running so it can be resumed in place.

    tmux-claude-sessions save      snapshot pane -> session id  (run before restart)
    tmux-claude-sessions restore   re-launch `claude -r <id>` in each saved pane
    tmux-claude-sessions list      show what's currently detected

How the mapping works: Claude writes a transcript per conversation to
~/.claude/projects/<cwd>/<session-id>.jsonl and stamps it with an `aiTitle`.
Claude also sets that title as the terminal/pane title, so pane title -> aiTitle
-> session id. Panes whose title matches no transcript are left alone.
"""
import json, glob, os, re, shlex, subprocess, sys, time

STATE = os.path.expanduser("~/.local/share/tmux/claude-sessions.json")
PROJECTS = os.path.expanduser("~/.claude/projects")


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout


def transcripts():
    """{aiTitle: [(session_id, mtime, project_dir), ...]} newest first."""
    out = {}
    for f in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        title = None
        try:
            with open(f, errors="ignore") as fh:
                for line in fh:
                    if '"aiTitle"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    if d.get("aiTitle"):
                        title = d["aiTitle"]
        except OSError:
            continue
        if title:
            out.setdefault(title, []).append(
                (os.path.basename(f)[:-6], os.path.getmtime(f), os.path.dirname(f))
            )
    for v in out.values():
        v.sort(key=lambda t: -t[1])
    return out


def pane_claude_flags(pane):
    """Flags the `claude` in this pane is currently running with.

    Captured so a restore reproduces how you actually launched it (e.g.
    --dangerously-skip-permissions) instead of a bare `claude -r <id>`.
    Resume arguments are stripped — restore supplies its own.
    """
    pid = tmux("display-message", "-p", "-t", pane, "#{pane_pid}").strip()
    if not pid:
        return []
    try:
        kids = subprocess.run(["pgrep", "-P", pid], capture_output=True,
                              text=True).stdout.split()
    except Exception:
        return []
    for kid in kids:
        cmd = subprocess.run(["ps", "-o", "command=", "-p", kid],
                             capture_output=True, text=True).stdout.strip()
        if not cmd:
            continue
        try:
            parts = shlex.split(cmd)
        except ValueError:
            continue
        if not parts or os.path.basename(parts[0]) != "claude":
            continue
        flags, drop_next = [], False
        for a in parts[1:]:
            if drop_next:
                drop_next = False
                # only swallow it if it really was the session id / transcript
                if re.fullmatch(r"[0-9a-fA-F-]{36}", a) or "/" in a:
                    continue
            if a in ("-r", "--resume", "--session-id", "--fork-session"):
                drop_next = a in ("-r", "--resume", "--session-id")
                continue
            if a.startswith(("--resume=", "--session-id=")):
                continue
            flags.append(a)
        return flags
    return []


def detect():
    """[(pane, cwd, title, session_id, flags)] for panes running a Claude conversation."""
    by_title = transcripts()
    used, rows = set(), []
    listing = tmux(
        "list-panes", "-a", "-F",
        "#{session_name}:#{window_index}.#{pane_index}|#{pane_current_path}|#{pane_title}",
    ).strip()
    for line in listing.split("\n"):
        if not line:
            continue
        try:
            pane, cwd, title = line.split("|", 2)
        except ValueError:
            continue
        # Claude prefixes the title with a spinner/status glyph
        clean = re.sub(r"^[^\w]+\s*", "", title).strip()
        cands = by_title.get(clean)
        if not cands:
            continue
        # Two panes can share a title; hand out distinct ids, newest first.
        sid = next((s for s, _, _ in cands if s not in used), None)
        if not sid:
            continue
        used.add(sid)
        rows.append((pane, cwd, clean, sid, pane_claude_flags(pane)))
    return rows


def cmd_list():
    rows = detect()
    if not rows:
        print("no panes with a resumable Claude conversation")
        return
    for pane, cwd, title, sid, flags in rows:
        extra = ('  ' + ' '.join(flags)) if flags else ''
        print(f"  {pane:16} {sid[:8]}  {title[:46]}{extra}")
    print(f"\n{len(rows)} pane(s)")


def cmd_save():
    rows = detect()
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as fh:
        json.dump(
            {"saved_at": time.time(),
             "panes": [{"pane": p, "cwd": c, "title": t, "session": s, "flags": f}
                       for p, c, t, s, f in rows]},
            fh, indent=2,
        )
    print(f"saved {len(rows)} Claude pane(s) -> {STATE}")


def live_panes():
    return set(tmux("list-panes", "-a", "-F",
                    "#{session_name}:#{window_index}.#{pane_index}").split())


def wait_for_panes(want, timeout=45):
    """Block until every saved pane exists.

    After a reboot, tmux-continuum triggers resurrect's restore when the server
    starts, and recreating the sessions takes a few seconds. Running restore
    before that finishes is why panes look like they 'no longer exist'.
    """
    live = live_panes()
    if want <= live:
        return live
    deadline = time.time() + timeout
    print(f"waiting for tmux-resurrect to recreate panes "
          f"({len(want & live)}/{len(want)} present) ...")
    while time.time() < deadline:
        time.sleep(1)
        live = live_panes()
        if want <= live:
            print("all panes present")
            return live
    missing = len(want - live)
    print(f"timed out after {timeout}s — {missing} pane(s) still missing; "
          f"restoring the rest")
    return live


def cmd_restore(dry=False, timeout=45):
    try:
        with open(STATE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        sys.exit(f"nothing saved at {STATE} — run `tmux-claude-sessions save` first")

    if not tmux("list-sessions").strip():
        sys.exit("tmux server isn't running — start tmux first (continuum will "
                 "restore your sessions), then re-run this")

    want = {p["pane"] for p in data.get("panes", [])}
    live = wait_for_panes(want, timeout)
    done = skipped = 0
    for p in data.get("panes", []):
        pane, sid, cwd = p["pane"], p["session"], p["cwd"]
        if pane not in live:
            print(f"  skip {pane:16} pane no longer exists")
            skipped += 1
            continue
        # only type into an idle shell, never over a running program
        cur = tmux("display-message", "-p", "-t", pane, "#{pane_current_command}").strip()
        if cur not in ("zsh", "bash", "sh", "fish"):
            print(f"  skip {pane:16} busy running {cur!r}")
            skipped += 1
            continue
        # Reproduce how the pane was actually launched. Falls back to
        # $CLAUDE_RESTORE_FLAGS for entries saved before flags were recorded.
        flags = p.get("flags")
        if flags is None:
            flags = shlex.split(os.environ.get("CLAUDE_RESTORE_FLAGS", ""))
        flag_str = (" " + " ".join(shlex.quote(f) for f in flags)) if flags else ""
        cmd = f"cd {cwd!r} && claude{flag_str} -r {sid}"
        if dry:
            print(f"  [dry] {pane:16} {cmd}")
        else:
            tmux("send-keys", "-t", pane, cmd, "Enter")
            print(f"  sent {pane:16} claude -r {sid[:8]}")
        done += 1
    verb = "would resume" if dry else "resumed"
    print(f"\n{verb} {done} pane(s), skipped {skipped}")


if __name__ == "__main__":
    args = sys.argv[1:]
    dry = "--dry-run" in args or "-n" in args
    timeout = 45
    for a in args:
        if a.startswith("--timeout="):
            try: timeout = int(a.split("=", 1)[1])
            except ValueError: pass
    action = next((a for a in args if not a.startswith("-")), "list")
    if action == "restore":
        cmd_restore(dry=dry, timeout=timeout)
    elif action == "save":
        cmd_save()
    elif action == "list":
        cmd_list()
    else:
        sys.exit(__doc__)
